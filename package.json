{
  "name": "disity",
  "version": "1.0.0",
  "description": "Lightweight dependency injection for TypeScript applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run typecheck && npm run test:run && npm run build"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
