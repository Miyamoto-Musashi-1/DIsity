{
  "name": "disity",
  "version": "1.0.1",
  "description": "Lightweight dependency injection for TypeScript applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dependency injection",
    "decorators",
    "injectable",
    "inversion of control"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "validate:package": "node scripts/validate-package.mjs",
    "check": "npm run typecheck && npm run test:run && npm run build && npm run validate:package",
    "prepack": "npm run check"
  },
  "author": "Huy Duong",
  "email": "huyduong.tech@gmail.com",
  "url": "https://github.com/Miyamoto-Musashi-1/DIsity",
  "license": "MIT",
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
