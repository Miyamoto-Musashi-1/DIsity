{
    "compilerOptions": {
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
  
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true,
  
      "outDir": "./dist",
      "strict": true
    },
  
    "include": [
      "src/**/*.ts",
      "examples/**/*.ts",
      "tests/**/*.ts",
    ],

    "exclude": [
      "node_modules",
      "dist"
    ]
}